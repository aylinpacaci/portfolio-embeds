<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>AIDA — Market Positioning</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600;700&family=DM+Sans:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
html{background:transparent}
body{
  max-width:782px;margin:0 auto;
  background:transparent;
  font-family:'DM Sans',system-ui,sans-serif;
  overflow-x:hidden;
}

/* ══════════════════════════════════════
   THEME SYSTEM — CSS custom properties
   ══════════════════════════════════════ */

/* ── LIGHT (default) ── */
:root, [data-theme="light"] {
  --card-bg: #FFFFFF;
  --card-border: rgba(0,0,0,.08);
  --svg-bg: #F8F8F6;
  --grid-dot: rgba(0,0,0,.06);
  --crosshair: rgba(0,0,0,.07);
  --quad-label: rgba(0,0,0,.14);
  --axis-line: rgba(0,0,0,.1);
  --axis-label: rgba(0,0,0,.35);
  --axis-endpoint: rgba(0,0,0,.22);
  --connector-line: rgba(59,108,211,.15);
  --text-primary: rgba(0,0,0,.85);
  --text-secondary: rgba(0,0,0,.4);
  --text-dim: rgba(0,0,0,.3);
  --node-general-fill: rgba(0,0,0,.12);
  --node-general-stroke: rgba(0,0,0,.2);
  --node-general-label: rgba(0,0,0,.5);
  --node-iati-label: #2B5BBF;
  --tooltip-bg: #FFFFFF;
  --tooltip-border: rgba(0,0,0,.08);
  --tooltip-shadow: rgba(0,0,0,.12);
  --tooltip-name: #111;
  --tooltip-desc: rgba(0,0,0,.5);
  --tooltip-coord-dim: rgba(0,0,0,.3);
  --tooltip-coord-val: rgba(0,0,0,.6);
  --tooltip-sep: rgba(0,0,0,.06);
  --legend-border: rgba(0,0,0,.05);
  --legend-text: rgba(0,0,0,.35);
  --legend-general-dot: rgba(0,0,0,.2);
  --mode-bg: rgba(0,0,0,.03);
  --mode-text: rgba(0,0,0,.35);
  --mode-active-bg: rgba(0,0,0,.07);
  --mode-active-text: rgba(0,0,0,.7);
  --mode-hover-text: rgba(0,0,0,.55);
  --quad-glow-color: rgba(59,108,211,.05);
  --ring-hover: rgba(59,108,211,.15);
}

/* ── DARK ── */
[data-theme="dark"] {
  --card-bg: #1A1A1A;
  --card-border: rgba(255,255,255,.06);
  --svg-bg: #1A1A1A;
  --grid-dot: rgba(255,255,255,.07);
  --crosshair: rgba(255,255,255,.06);
  --quad-label: rgba(255,255,255,.14);
  --axis-line: rgba(255,255,255,.08);
  --axis-label: rgba(255,255,255,.3);
  --axis-endpoint: rgba(255,255,255,.18);
  --connector-line: rgba(59,108,211,.18);
  --text-primary: rgba(255,255,255,.85);
  --text-secondary: rgba(255,255,255,.3);
  --text-dim: rgba(255,255,255,.35);
  --node-general-fill: rgba(255,255,255,.18);
  --node-general-stroke: rgba(255,255,255,.28);
  --node-general-label: rgba(255,255,255,.5);
  --node-iati-label: #7BA4F0;
  --tooltip-bg: #232321;
  --tooltip-border: rgba(255,255,255,.08);
  --tooltip-shadow: rgba(0,0,0,.5);
  --tooltip-name: #fff;
  --tooltip-desc: rgba(255,255,255,.5);
  --tooltip-coord-dim: rgba(255,255,255,.3);
  --tooltip-coord-val: rgba(255,255,255,.6);
  --tooltip-sep: rgba(255,255,255,.06);
  --legend-border: rgba(255,255,255,.04);
  --legend-text: rgba(255,255,255,.35);
  --legend-general-dot: rgba(255,255,255,.25);
  --mode-bg: rgba(255,255,255,.04);
  --mode-text: rgba(255,255,255,.35);
  --mode-active-bg: rgba(255,255,255,.08);
  --mode-active-text: rgba(255,255,255,.8);
  --mode-hover-text: rgba(255,255,255,.55);
  --quad-glow-color: rgba(59,108,211,.07);
  --ring-hover: rgba(59,108,211,.25);
}

/* ── Transitions for smooth theme switch ── */
.card, .tip, .legend, .mode-toggle, .mode-btn {
  transition: background .3s, border-color .3s, color .3s, box-shadow .3s;
}

/* ── CARD ── */
.card{
  position:relative;
  background:var(--card-bg);
  border-radius:12px;
  overflow:hidden;
  border:1px solid var(--card-border);
}

/* ── HEADER ── */
.head{
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 24px 0;
}
.head-left{display:flex;align-items:center;gap:10px}
.logo{
  width:28px;height:28px;background:#3B6CD3;border-radius:6px;
  display:flex;align-items:center;justify-content:center;
  font-family:'Prompt',sans-serif;font-weight:700;font-size:12px;color:#fff;
}
.head-title{font-family:'Prompt',sans-serif;font-weight:600;font-size:13px;color:var(--text-primary)}
.head-sub{font-size:11px;color:var(--text-secondary);margin-left:4px}

.mode-toggle{
  display:flex;gap:2px;
  background:var(--mode-bg);border-radius:6px;padding:2px;
}
.mode-btn{
  font-family:'DM Sans',sans-serif;font-size:10px;font-weight:500;
  padding:5px 11px;border-radius:5px;border:none;
  background:transparent;color:var(--mode-text);
  cursor:pointer;transition:all .2s;
}
.mode-btn.active{background:var(--mode-active-bg);color:var(--mode-active-text)}
.mode-btn:hover:not(.active){color:var(--mode-hover-text)}

/* ── CHART AREA ── */
.chart-area{
  position:relative;
  padding:14px 24px 10px;
}
.chart-area svg{display:block;width:100%}

/* ── TOOLTIP ── */
.tip{
  position:absolute;pointer-events:none;
  background:var(--tooltip-bg);
  border:1px solid var(--tooltip-border);
  border-radius:8px;
  padding:14px 16px;
  max-width:240px;
  box-shadow:0 8px 32px var(--tooltip-shadow),0 0 0 1px var(--tooltip-border);
  opacity:0;
  transform:translateY(4px) scale(.97);
  transition:opacity .15s, transform .15s cubic-bezier(.4,0,.2,1);
  z-index:40;
}
.tip.show{opacity:1;transform:translateY(0) scale(1)}
.tip-cat{font-size:9.5px;font-weight:500;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px}
.tip-name{font-family:'Prompt',sans-serif;font-weight:600;font-size:14px;color:var(--tooltip-name);margin-bottom:5px}
.tip-desc{font-size:11.5px;line-height:1.6;color:var(--tooltip-desc)}
.tip-coords{
  display:flex;gap:14px;margin-top:10px;padding-top:9px;
  border-top:1px solid var(--tooltip-sep);
}
.tip-coord{font-size:10px;color:var(--tooltip-coord-dim)}
.tip-coord span{color:var(--tooltip-coord-val);font-weight:500}

/* ── LEGEND ── */
.legend{
  display:flex;align-items:center;justify-content:center;
  flex-wrap:wrap;gap:20px;
  padding:14px 24px 18px;
  border-top:1px solid var(--legend-border);
}
.lg{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--legend-text)}
.lg-dot{width:9px;height:9px;border-radius:50%}
.lg-dot.aida{width:11px;height:11px;border-radius:3px}

/* ── ANIMATIONS ── */
@keyframes nodeIn{
  from{opacity:0;transform:scale(.7) translate(var(--dx),var(--dy))}
  to{opacity:1;transform:scale(1) translate(0,0)}
}
@keyframes aidaGlow{
  0%,100%{filter:drop-shadow(0 0 8px rgba(59,108,211,.3))}
  50%{filter:drop-shadow(0 0 16px rgba(59,108,211,.5))}
}
@keyframes fadeAxis{
  from{opacity:0}
  to{opacity:1}
}
@keyframes quadFade{
  from{opacity:0;transform:translateY(6px)}
  to{opacity:1;transform:translateY(0)}
}
</style>
</head>
<body>

<div class="card">
  <div class="head">
    <div class="head-left">
      <div class="logo">A</div>
      <span class="head-title">AIDA</span>
      <span class="head-sub">Market Positioning</span>
    </div>
    <div class="mode-toggle">
      <button class="mode-btn active" data-mode="all">All</button>
      <button class="mode-btn" data-mode="iati">IATI Tools</button>
      <button class="mode-btn" data-mode="general">General</button>
      <button class="mode-btn" data-mode="aida">AIDA Only</button>
    </div>
  </div>

  <div class="chart-area">
    <svg id="chart" viewBox="0 0 734 580" preserveAspectRatio="xMidYMid meet"></svg>
    <div class="tip" id="tip"></div>
  </div>

  <div class="legend">
    <div class="lg"><div class="lg-dot" style="background:#3B6CD3"></div>IATI / Aid-focused tools</div>
    <div class="lg"><div class="lg-dot" id="lg-general-dot"></div>General data platforms</div>
    <div class="lg"><div class="lg-dot aida" style="background:#3B6CD3;box-shadow:0 0 8px rgba(59,108,211,.4)"></div>AIDA</div>
  </div>
</div>

<script>
/* ══════════════════════════════════════
   THEME ENGINE
   Supports: ?theme=light|dark URL param
             postMessage({theme:'light'|'dark'})
   ══════════════════════════════════════ */

let currentTheme='dark';

function setTheme(name){
  currentTheme=name;
  document.documentElement.dataset.theme=name;
  /* update legend general dot */
  const gd=document.getElementById('lg-general-dot');
  if(gd) gd.style.background=name==='dark'?'rgba(255,255,255,.25)':'rgba(0,0,0,.2)';
  render();
  if(currentMode!=='all') applyMode();
}

function detectTheme(){
  const p=new URLSearchParams(location.search).get('theme');
  if(p==='light'||p==='dark') return p;
  return window.matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';
}


const NS='http://www.w3.org/2000/svg';
const chart=document.getElementById('chart');
const tip=document.getElementById('tip');

/* ─── LAYOUT ─── */
const PAD={l:62,r:34,t:48,b:62};
const W=734, H=580;
const plotW=W-PAD.l-PAD.r, plotH=H-PAD.t-PAD.b;

function xPos(v){return PAD.l+v/100*plotW}
function yPos(v){return PAD.t+(100-v)/100*plotH}

/* ─── Theme-aware color getters ─── */
function T(){
  const dark=currentTheme==='dark';
  return {
    svgBg:         dark ? '#1A1A1A' : '#F8F8F6',
    gridDot:       dark ? 'rgba(255,255,255,.07)' : 'rgba(0,0,0,.06)',
    crosshair:     dark ? 'rgba(255,255,255,.06)' : 'rgba(0,0,0,.07)',
    quadLabel:     dark ? 'rgba(255,255,255,.14)' : 'rgba(0,0,0,.14)',
    axisLine:      dark ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.1)',
    axisLabel:     dark ? 'rgba(255,255,255,.3)'  : 'rgba(0,0,0,.35)',
    axisEndpoint:  dark ? 'rgba(255,255,255,.18)' : 'rgba(0,0,0,.22)',
    connectorLine: dark ? 'rgba(59,108,211,.18)'  : 'rgba(59,108,211,.15)',
    genFill:       dark ? 'rgba(255,255,255,.18)' : 'rgba(0,0,0,.12)',
    genStroke:     dark ? 'rgba(255,255,255,.28)' : 'rgba(0,0,0,.2)',
    genLabel:      dark ? 'rgba(255,255,255,.5)'  : 'rgba(0,0,0,.5)',
    iatiLabel:     dark ? '#7BA4F0' : '#2B5BBF',
    quadGlow:      dark ? 'rgba(59,108,211,.07)'  : 'rgba(59,108,211,.05)',
    quadGlowEnd:   dark ? 'rgba(59,108,211,0)'    : 'rgba(59,108,211,0)',
    tipCatIati:    dark ? '#5B8AE8' : '#2B5BBF',
    tipCatGen:     dark ? 'rgba(255,255,255,.35)' : 'rgba(0,0,0,.35)',
  };
}

/* ─── DATA ─── */
const POINTS=[
  {id:'datastore',  label:'IATI Datastore', x:6,  y:18, cat:'iati',
   desc:'Raw API access to IATI XML. Machine-readable, no exploration UI.'},
  {id:'oipa',       label:'OIPA',           x:14, y:12, cat:'iati',
   desc:'IATI query API for developers. No visualisation or publishing layer.'},
  {id:'dportal',    label:'D-Portal',       x:28, y:32, cat:'iati',
   desc:'IATI browsing tool. Explorer-only, no publishing workflow.'},
  {id:'iatipub',    label:'IATI Publisher',  x:36, y:46, cat:'iati',
   desc:'Official IATI publishing tool. Functional but friction-heavy.'},
  {id:'aidstream',  label:'Aidstream',      x:40, y:56, cat:'iati',
   desc:'IATI publishing tool for NGOs. Publish-only, no exploration.'},
  {id:'hdx',        label:'UN OCHA HDX',    x:46, y:48, cat:'general',
   desc:'Humanitarian data hub. Explore only, no IATI compliance workflow.'},
  {id:'devini',     label:'Dev Initiatives', x:54, y:62, cat:'general',
   desc:'Research-focused insights platform. Curated, not self-serve.'},
  {id:'powerbi',    label:'Power BI',       x:60, y:70, cat:'general',
   desc:'Microsoft BI. Flexible but not IATI-specific; needs configuration.'},
  {id:'tableau',    label:'Tableau',        x:68, y:74, cat:'general',
   desc:'General BI tool. Powerful but requires data prep and expertise.'},
  {id:'flourish',   label:'Flourish',       x:74, y:58, cat:'general',
   desc:'Dataviz tool for journalists. Beautiful output, no IATI integration.'},
  {id:'aida',       label:'AIDA',           x:84, y:88, cat:'aida',
   desc:'Explorer + Publisher in one platform. Accessible to non-technical users with full IATI compliance workflow.'},
];

function catStyle(){
  const t=T();
  return {
    iati:   {fill:'#3B6CD3',stroke:'#5B8AE8',r:7,  labelColor:t.iatiLabel},
    general:{fill:t.genFill, stroke:t.genStroke,r:6.5, labelColor:t.genLabel},
    aida:   {fill:'#3B6CD3',stroke:'#5B8AE8',r:14, labelColor:'#fff'},
  };
}

/* ─── SVG HELPERS ─── */
function el(tag,attrs,parent){
  const e=document.createElementNS(NS,tag);
  if(attrs) for(const[k,v]of Object.entries(attrs)) e.setAttribute(k,v);
  if(parent) parent.appendChild(e);
  return e;
}

/* ─── RENDER ─── */
let nodeEls={}, labelEls={}, connectorEls=[];
let currentMode='all';

function render(){
  chart.innerHTML='';
  const t=T();
  const CS=catStyle();

  const defs=el('defs',{},chart);

  /* radial gradient for top-right quadrant highlight */
  const rg=el('radialGradient',{id:'quadGlow',cx:'100%',cy:'0%',r:'80%',fx:'95%',fy:'5%'},defs);
  el('stop',{offset:'0%','stop-color':t.quadGlow},rg);
  el('stop',{offset:'100%','stop-color':t.quadGlowEnd},rg);

  /* glow filter for AIDA */
  const filt=el('filter',{id:'aidaGlow',x:'-50%',y:'-50%',width:'200%',height:'200%'},defs);
  el('feGaussianBlur',{in:'SourceGraphic',stdDeviation:'5',result:'blur'},filt);
  const merge=el('feMerge',{},filt);
  el('feMergeNode',{in:'blur'},merge);
  el('feMergeNode',{in:'SourceGraphic'},merge);

  /* ── background ── */
  el('rect',{x:0,y:0,width:W,height:H,fill:t.svgBg,rx:'0'},chart);

  /* ── subtle dot grid ── */
  const gridG=el('g',{opacity:'0.35'},chart);
  for(let gx=PAD.l;gx<=W-PAD.r;gx+=plotW/16){
    for(let gy=PAD.t;gy<=H-PAD.b;gy+=plotH/16){
      el('circle',{cx:gx,cy:gy,r:'0.6',fill:t.gridDot},gridG);
    }
  }

  /* ── quadrant shading (top-right) ── */
  const qx=xPos(50), qy=yPos(50);
  el('rect',{x:qx,y:PAD.t,width:W-PAD.r-qx,height:qy-PAD.t,
    fill:'url(#quadGlow)',
    style:'animation:fadeAxis .8s .6s both'},chart);

  /* ── crosshair lines ── */
  const crossG=el('g',{style:'animation:fadeAxis .6s .3s both'},chart);
  el('line',{x1:xPos(50),y1:PAD.t,x2:xPos(50),y2:H-PAD.b,
    stroke:t.crosshair,'stroke-width':'1','stroke-dasharray':'4 5'},crossG);
  el('line',{x1:PAD.l,y1:yPos(50),x2:W-PAD.r,y2:yPos(50),
    stroke:t.crosshair,'stroke-width':'1','stroke-dasharray':'4 5'},crossG);

  /* ── quadrant labels ── */
  const quads=[
    {x:PAD.l+12, y:H-PAD.b-14, anchor:'start', text:'Technical only', delay:'.9s'},
    {x:W-PAD.r-12, y:H-PAD.b-14, anchor:'end', text:'Accessible, limited scope', delay:'1s'},
    {x:PAD.l+12, y:PAD.t+18, anchor:'start', text:'Specialist explorer / publisher', delay:'1.1s'},
    {x:W-PAD.r-12, y:PAD.t+18, anchor:'end', text:'Full platform', delay:'1.2s'},
  ];
  quads.forEach(q=>{
    const tx=el('text',{x:q.x,y:q.y,'text-anchor':q.anchor,
      'dominant-baseline':'middle',
      fill:t.quadLabel,
      'font-family':"'Prompt',sans-serif",'font-size':'11','font-weight':'500',
      'letter-spacing':'.03em',
      style:`animation:quadFade .5s ${q.delay} both`},chart);
    tx.textContent=q.text;
  });

  /* ── axes ── */
  const axisG=el('g',{style:'animation:fadeAxis .5s .2s both'},chart);

  /* x-axis line */
  el('line',{x1:PAD.l,y1:H-PAD.b,x2:W-PAD.r,y2:H-PAD.b,
    stroke:t.axisLine,'stroke-width':'1'},axisG);
  /* x-axis center label */
  const xLabel=el('text',{x:W/2,y:H-18,'text-anchor':'middle',
    fill:t.axisLabel,
    'font-family':"'DM Sans',sans-serif",'font-size':'11','font-weight':'500'},axisG);
  xLabel.textContent='User accessibility →';
  /* x endpoints */
  const xL=el('text',{x:PAD.l,y:H-18,'text-anchor':'start',
    fill:t.axisEndpoint,
    'font-family':"'DM Sans',sans-serif",'font-size':'10'},axisG);
  xL.textContent='Technical';
  const xR=el('text',{x:W-PAD.r,y:H-18,'text-anchor':'end',
    fill:t.axisEndpoint,
    'font-family':"'DM Sans',sans-serif",'font-size':'10'},axisG);
  xR.textContent='Non-technical';

  /* y-axis line */
  el('line',{x1:PAD.l,y1:PAD.t,x2:PAD.l,y2:H-PAD.b,
    stroke:t.axisLine,'stroke-width':'1'},axisG);
  /* y-axis label */
  const yLabel=el('text',{x:16,y:H/2,'text-anchor':'middle',
    fill:t.axisLabel,
    'font-family':"'DM Sans',sans-serif",'font-size':'11','font-weight':'500',
    transform:`rotate(-90 16 ${H/2})`},axisG);
  yLabel.textContent='Feature completeness →';
  /* y endpoints */
  const yB=el('text',{x:PAD.l-10,y:H-PAD.b,'text-anchor':'end',
    fill:t.axisEndpoint,'dominant-baseline':'middle',
    'font-family':"'DM Sans',sans-serif",'font-size':'10'},axisG);
  yB.textContent='Low';
  const yT=el('text',{x:PAD.l-10,y:PAD.t,'text-anchor':'end',
    fill:t.axisEndpoint,'dominant-baseline':'middle',
    'font-family':"'DM Sans',sans-serif",'font-size':'10'},axisG);
  yT.textContent='High';

  /* ── connector lines (hidden, shown on AIDA hover) ── */
  const connG=el('g',{id:'connectors',opacity:'0'},chart);
  connectorEls=[];
  const aidaPt=POINTS.find(p=>p.id==='aida');
  const ax=xPos(aidaPt.x), ay=yPos(aidaPt.y);
  POINTS.forEach(p=>{
    if(p.id==='aida') return;
    const px=xPos(p.x), py=yPos(p.y);
    const line=el('line',{x1:ax,y1:ay,x2:px,y2:py,
      stroke:t.connectorLine,'stroke-width':'0.8',
      'stroke-dasharray':'4 4'},connG);
    connectorEls.push(line);
  });

  /* ── nodes ── */
  const nodesG=el('g',{id:'nodes'},chart);
  nodeEls={};
  labelEls={};

  POINTS.forEach((p,i)=>{
    const s=CS[p.cat];
    const px=xPos(p.x), py=yPos(p.y);
    const g=el('g',{'data-pid':p.id,style:'cursor:pointer'},nodesG);
    nodeEls[p.id]=g;

    /* stagger delay */
    const dist=Math.sqrt(p.x*p.x+p.y*p.y);
    const delay=(dist/130*0.6+0.4).toFixed(2);
    const dx=((50-p.x)*0.8).toFixed(0);
    const dy=((50-p.y)*-0.8).toFixed(0);

    g.style.cssText=`
      --dx:${dx}px;--dy:${dy}px;
      transform-origin:${px}px ${py}px;
      animation:nodeIn .8s ${delay}s cubic-bezier(.25,.1,.25,1) both;
    `;

    if(p.cat==='aida'){
      /* pulsing rings */
      const pulseG=el('g',{},g);
      for(let ring=0;ring<3;ring++){
        const c=el('circle',{cx:px,cy:py,r:'0',
          fill:'none',stroke:'rgba(59,108,211,.2)','stroke-width':'1'},pulseG);
        c.innerHTML=`<animate attributeName="r" from="14" to="38" dur="2.6s"
          begin="${ring*0.85}s" repeatCount="indefinite"/>
          <animate attributeName="opacity" from="0.45" to="0" dur="2.6s"
          begin="${ring*0.85}s" repeatCount="indefinite"/>`;
      }

      /* outer glow */
      el('circle',{cx:px,cy:py,r:s.r+8,fill:'rgba(59,108,211,.06)',filter:'url(#aidaGlow)'},g);

      /* main dot — rounded square */
      el('rect',{x:px-s.r,y:py-s.r,width:s.r*2,height:s.r*2,rx:5,
        fill:s.fill,stroke:s.stroke,'stroke-width':'1.5',
        style:'animation:aidaGlow 3s ease-in-out infinite'},g);

      /* label — positioned to the LEFT of the node */
      const lt=el('text',{x:px-s.r-12,y:py+1,'text-anchor':'end',
        fill:s.labelColor,
        'font-family':"'Prompt',sans-serif",'font-size':'16','font-weight':'700',
        'letter-spacing':'.02em'},g);
      lt.textContent=p.label;
      labelEls[p.id]=lt;

    } else {
      /* hover ring */
      el('circle',{cx:px,cy:py,r:s.r+5,
        fill:'none',stroke:s.stroke,'stroke-width':'0.6',
        opacity:'0','data-ring':'1'},g);

      /* main dot */
      el('circle',{cx:px,cy:py,r:s.r,fill:s.fill,stroke:s.stroke,'stroke-width':'0.8'},g);

      /* label — smart positioning per node to avoid overlaps */
      let lx=px, ly=py-s.r-10;
      let anchor='middle';

      if(p.id==='oipa'){ly=py+s.r+16}
      if(p.id==='datastore'){lx=px+s.r+8;ly=py+2;anchor='start'}
      if(p.id==='powerbi'){lx=px-s.r-8;anchor='end';ly=py+2}
      if(p.id==='flourish'){ly=py+s.r+16}
      if(p.id==='hdx'){lx=px+s.r+8;anchor='start';ly=py+2}
      if(p.id==='iatipub'){lx=px+s.r+8;anchor='start';ly=py+2}
      if(p.id==='devini'){ly=py-s.r-10}
      if(p.id==='tableau'){ly=py-s.r-10}

      const lt=el('text',{x:lx,y:ly,'text-anchor':anchor,
        fill:s.labelColor,
        'font-family':"'DM Sans',sans-serif",'font-size':'12','font-weight':'500'},g);
      lt.textContent=p.label;
      labelEls[p.id]=lt;
    }

    /* invisible hit area */
    el('circle',{cx:px,cy:py,r:Math.max(s.r+10,18),fill:'transparent',stroke:'none'},g);

    /* events */
    g.addEventListener('mouseenter',(ev)=>handleHover(p,g,ev,true));
    g.addEventListener('mousemove',(ev)=>moveTip(ev));
    g.addEventListener('mouseleave',()=>handleHover(p,g,null,false));
  });
}

/* ─── INTERACTION ─── */
function handleHover(point,g,ev,enter){
  const CS=catStyle();
  const s=CS[point.cat];
  const t=T();
  const px=xPos(point.x), py=yPos(point.y);

  if(enter){
    /* expand node */
    const circles=g.querySelectorAll('circle:not([data-ring])');
    circles.forEach(c=>{
      if(c.getAttribute('fill')!=='transparent'){
        c.style.transition='r .2s cubic-bezier(.34,1.56,.64,1)';
        const origR=parseFloat(c.getAttribute('r'));
        c.setAttribute('r',origR*1.3);
      }
    });
    /* show ring */
    const ring=g.querySelector('[data-ring]');
    if(ring){ring.style.transition='opacity .15s';ring.setAttribute('opacity','1')}

    /* show connectors if hovering AIDA */
    if(point.cat==='aida'){
      document.getElementById('connectors').style.transition='opacity .3s';
      document.getElementById('connectors').style.opacity='1';
    }

    /* dim other nodes */
    POINTS.forEach(p=>{
      if(p.id!==point.id && nodeEls[p.id]){
        nodeEls[p.id].style.transition='opacity .2s';
        nodeEls[p.id].style.opacity=point.cat==='aida'?'0.5':'0.25';
      }
    });

    /* tooltip */
    const catName={iati:'IATI / Aid-focused',general:'General platform',aida:'AIDA Platform'}[point.cat];
    const catColor={iati:t.tipCatIati,general:t.tipCatGen,aida:'#3B6CD3'}[point.cat];
    tip.innerHTML=`
      <div class="tip-cat" style="color:${catColor}">${catName}</div>
      <div class="tip-name">${point.label}</div>
      <div class="tip-desc">${point.desc}</div>
      <div class="tip-coords">
        <div class="tip-coord">Accessibility <span>${point.x}%</span></div>
        <div class="tip-coord">Completeness <span>${point.y}%</span></div>
      </div>
    `;
    moveTip(ev);
    tip.classList.add('show');

  } else {
    /* restore node sizes */
    if(point.cat==='aida'){
      g.querySelectorAll('circle:not([data-ring])').forEach(c=>{
        if(c.getAttribute('fill')!=='transparent'){
          c.setAttribute('r', c.getAttribute('fill')==='rgba(59,108,211,.06)'?s.r+8:0);
        }
      });
    } else {
      g.querySelectorAll('circle:not([data-ring])').forEach(c=>{
        if(c.getAttribute('fill')!=='transparent') c.setAttribute('r',s.r);
      });
    }
    const ring=g.querySelector('[data-ring]');
    if(ring) ring.setAttribute('opacity','0');

    /* hide connectors */
    if(point.cat==='aida'){
      document.getElementById('connectors').style.opacity='0';
    }

    /* restore others */
    POINTS.forEach(p=>{
      if(nodeEls[p.id]){
        nodeEls[p.id].style.opacity=currentMode==='all'?'1':
          (p.cat===currentMode||p.cat==='aida')?'1':'0.06';
      }
    });

    tip.classList.remove('show');
  }
}

function moveTip(ev){
  const area=document.querySelector('.chart-area');
  const rect=area.getBoundingClientRect();
  let tx=ev.clientX-rect.left+16;
  let ty=ev.clientY-rect.top-10;
  const tw=tip.offsetWidth||220;
  const th=tip.offsetHeight||100;
  if(tx+tw>rect.width-12) tx=ev.clientX-rect.left-tw-16;
  if(ty+th>rect.height-8) ty=rect.height-th-8;
  if(ty<4) ty=4;
  tip.style.left=tx+'px';
  tip.style.top=ty+'px';
}

/* ─── MODE FILTER ─── */
document.querySelectorAll('.mode-btn').forEach(btn=>{
  btn.addEventListener('click',function(){
    document.querySelectorAll('.mode-btn').forEach(b=>b.classList.remove('active'));
    this.classList.add('active');
    currentMode=this.dataset.mode;
    applyMode();
  });
});

function applyMode(){
  POINTS.forEach(p=>{
    if(!nodeEls[p.id]) return;
    const g=nodeEls[p.id];
    let vis=true;
    if(currentMode==='iati') vis=(p.cat==='iati'||p.cat==='aida');
    if(currentMode==='general') vis=(p.cat==='general'||p.cat==='aida');
    if(currentMode==='aida') vis=(p.cat==='aida');
    g.style.animationFillMode='none';
    g.style.transition='opacity .35s cubic-bezier(.4,0,.2,1)';
    g.style.opacity=vis?'1':'0.06';
  });
}

/* ═══════════════════════════════════════════════════
   THEME SWITCHING
   Priority: URL param > postMessage > prefers-color-scheme
═══════════════════════════════════════════════════ */

/* initial render */
setTheme(detectTheme());

/* OS preference changes (only when no URL override is present) */
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',e=>{
  if(!new URLSearchParams(location.search).has('theme')) setTheme(e.matches?'dark':'light');
});

/* postMessage from Framer parent:
   send window.postMessage({type:'theme', value:'light'}, '*') from a Framer code component */
window.addEventListener('message',e=>{
  const d=e.data;
  if(!d) return;
  const v=d.value||d.colorScheme;
  if((d.type==='theme'||d.colorScheme)&&(v==='light'||v==='dark')) setTheme(v);
});

/* After entrance animations, unlock opacity for mode filter */
setTimeout(()=>{
  document.querySelectorAll('#nodes [data-pid]').forEach(g=>{
    g.style.animationFillMode='none';
    g.style.opacity='1';
  });
},2600);
</script>

<script>
function postHeight(){
  const h=document.querySelector('.card').offsetHeight;
  window.parent.postMessage({type:'resize',height:h},'*');
}
window.addEventListener('load',postHeight);
new ResizeObserver(postHeight).observe(document.querySelector('.card'));
</script>
